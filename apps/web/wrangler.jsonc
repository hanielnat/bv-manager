{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "bv-manager",
    "main": "@tanstack/react-start/server-entry",
    "workers_dev": false,
    "compatibility_date": "2026-07-29",
    "compatibility_flags": ["nodejs_compat"],
    "observability": {
        "enabled": false,
        "logs": {
            "enabled": true,
            "persist": true,
            "invocation_logs": true,
        },
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "bv",
            "database_id": "39efd212-61a3-4735-90a9-0fb8490645d0",
            "migrations_dir": "../../packages/db/drizzle",
        },
    ],
    "env": {
        "production": {
            "name": "bv-manager-production",
            "workers_dev": true,
            "vars": {
                "ENVIRONMENT": "production",
                "BASE_URL": "https://bv-manager.olivs.workers.dev",
                "BETTER_AUTH_URL": "https://bv-manager.olivs.workers.dev",
            },
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "bv",
                    "database_id": "39efd212-61a3-4735-90a9-0fb8490645d0",
                    "migrations_dir": "../../packages/db/drizzle",
                },
            ],
        },
        "staging": {
            "name": "bv-manager-staging",
            "workers_dev": true,
            "vars": {
                "ENVIRONMENT": "staging",
                "BASE_URL": "https://bv-manager-staging.olivs.workers.dev",
                "BETTER_AUTH_URL": "https://bv-manager-staging.olivs.workers.dev",
            },
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "bv",
                    "database_id": "39efd212-61a3-4735-90a9-0fb8490645d0",
                    "migrations_dir": "../../packages/db/drizzle",
                },
            ],
        },
    },
}
