{
    "name": "db",
    "type": "module",
    "module": "index.ts",
    "scripts": {
        "build": "bun build --target bun index.ts --outdir dist/",
        "check": "bunx tsc --noEmit -p tsconfig.json",
        "db:generate": "bun drizzle-kit generate",
        "db:migrate": "bun drizzle-kit migrate",
        "db:studio": "bun drizzle-kit studio",
        "db:studio:local": "bun drizzle-kit studio --config=drizzle.config.local.ts"
    },
    "dependencies": {
        "drizzle-orm": "^0.45.2"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "drizzle-kit": "^0.31.10"
    },
    "peerDependencies": {
        "typescript": "^5"
    }
}
