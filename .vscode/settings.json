{
    "npm.packageManager": "bun",
    "npm.scriptRunner": "bun",
    "files.associations": {
        "*.css": "tailwindcss"
    },
    "css.validate": false,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "oxc.oxc-vscode",

    "files.watcherExclude": {
        "**/routeTree.gen.ts": true
    },
    "search.exclude": {
        "**/routeTree.gen.ts": true
    },
    "files.readonlyInclude": {
        "**/routeTree.gen.ts": true
    }
}
