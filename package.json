{
    "name": "bv-manager",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "dev": "bun --filter '*' dev",
        "dev:web": "bun --filter 'web' --elide-lines=0 dev",
        "dev:server": "bun --filter 'server' --elide-lines=0 dev",
        "build": "bun --filter '*' --env-file=.env build",
        "build:web": "bun --filter 'web' --env-file=.env build",
        "build:server": "bun --filter 'server' --env-file=.env build",
        "deploy": "bun run build:web && bun --filter 'web' --env-file=.env deploy",
        "preview": "bun run build:web && bun --filter 'web' --env-file=.env preview",
        "preview:cf": "bun run build:web && bun --filter 'web' --env-file=.env preview:cf",
        "lint": "oxlint",
        "fmt": "oxfmt",
        "lint:fix": "oxlint --fix",
        "fmt:check": "oxfmt --check",
        "db:drizzle:generate": "bun --cwd=packages/db db:generate",
        "db:drizzle:migrate": "bun --cwd=packages/db db:migrate",
        "db:migrate": "bun --cwd=apps/web wrangler d1 migrations apply bv --remote",
        "db:migrate:local": "bun --cwd=apps/web wrangler d1 migrations apply bv --local",
        "db:push": "bun --cwd=packages/db db:push",
        "db:studio": "bun --cwd=packages/db db:studio",
        "db:studio:local": "bun --cwd=packages/db db:studio:local"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/node": "^26.1.2",
        "oxfmt": "^0.59.0",
        "oxlint": "^1.74.0"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "packageManager": "bun"
}
