{
    "name": "bv-manager",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "dev": "bun --filter '*' dev",
        "dev:web": "bun --filter 'web' dev",
        "dev:server": "bun --filter 'server' dev",
        "lint": "oxlint",
        "fmt": "oxfmt",
        "lint:fix": "oxlint --fix",
        "fmt:check": "oxfmt --check"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "oxfmt": "^0.59.0",
        "oxlint": "^1.74.0"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "packageManager": "bun"
}
